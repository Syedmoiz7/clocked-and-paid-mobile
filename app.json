{
  "expo": {
    "name": "Clocked & Paid",
    "slug": "clocked-and-paid",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "clockedandpaid",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.clockedandpaid.mobile"
    },
    "android": {
      "package": "com.clockedandpaid.mobile"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-notifications",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to unlock your Clocked & Paid workspace."
        }
      ]
    ]
  }
}
