{
  "expo": {
    "name": "Clocked & Paid",
    "slug": "clocked-and-paid",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "clockedandpaid",
    "icon": "./assets/branding/icon.png",
    "backgroundColor": "#100a0d",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.clockedandpaid.mobile"
    },
    "android": {
      "package": "com.clockedandpaid.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/adaptive-foreground.png",
        "monochromeImage": "./assets/branding/adaptive-monochrome.png",
        "backgroundColor": "#bd3c6b"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#100a0d"
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-notifications",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to unlock your Clocked & Paid workspace."
        }
      ]
    ]
  }
}
